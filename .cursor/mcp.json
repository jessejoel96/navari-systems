{
  "mcpServers": {
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=zewvewxszqlmpmbptmeb"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "accesslint": {
      "command": "npx",
      "args": [
        "-y",
        "@accesslint/mcp@latest"
      ]
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server",
        "--transport",
        "stdio"
      ],
      "envFile": "${workspaceFolder}/.env.local"
    }
  }
}
